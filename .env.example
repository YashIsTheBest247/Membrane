# ---------------------------------------------------------------------------
# Membrane configuration. Copy to .env and edit.
# Every value has a working default except the two secrets, which you must
# change before this is exposed to anything you care about.
# ---------------------------------------------------------------------------

MEMBRANE_ENVIRONMENT=dev

# --- storage ---------------------------------------------------------------
# Default is a local SQLite file, so the proxy runs with no infrastructure.
# docker compose overrides this with Postgres.
# MEMBRANE_DATABASE_URL=postgresql+asyncpg://membrane:membrane@localhost:5432/membrane
# MEMBRANE_REDIS_URL=redis://localhost:6379/0

# --- secrets ---------------------------------------------------------------
# Signs intent contracts and Telegram callbacks. Rotating it invalidates every
# outstanding contract, which is the intended emergency behaviour.
MEMBRANE_SIGNING_KEY=change-me-openssl-rand-hex-32
# Salts every span hash in the audit trail. Rotating it makes historical hashes
# unlinkable — also intended.
MEMBRANE_HASH_SALT=change-me-openssl-rand-hex-32

# --- the human loop --------------------------------------------------------
# Without these, held actions are resolved from the dashboard instead.
# MEMBRANE_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# MEMBRANE_TELEGRAM_CHAT_ID=987654321
MEMBRANE_APPROVAL_TIMEOUT_SECONDS=60

# --- L2 model escalation ---------------------------------------------------
# Optional. Without it, ambiguous spans quarantine rather than pass: the
# deterministic tier alone is fail-closed, never fail-open.
# MEMBRANE_GEMINI_API_KEY=...
# MEMBRANE_VERTEX_PROJECT=my-gcp-project
# MEMBRANE_VERTEX_LOCATION=us-central1
# MEMBRANE_VERTEX_MODEL=gemini-2.0-flash

# --- policy ----------------------------------------------------------------
MEMBRANE_SEPARATOR_QUARANTINE_THRESHOLD=0.60
MEMBRANE_SEPARATOR_AMBIGUOUS_THRESHOLD=0.35
MEMBRANE_CONTRACT_TTL_SECONDS=900
MEMBRANE_BREAKER_HOLD_THRESHOLD=5
MEMBRANE_BREAKER_COOLDOWN_SECONDS=300
# MEMBRANE_POLICY_FILE=./policy.yaml

# --- privacy ---------------------------------------------------------------
# Live previews stream inspected text to the dashboard from memory. They are
# never persisted, but turn this off in production anyway.
MEMBRANE_LIVE_PREVIEW_ENABLED=true
# Bounded replay retention. Off by default; when on it expires automatically.
MEMBRANE_REPLAY_RETENTION_ENABLED=false
MEMBRANE_REPLAY_RETENTION_HOURS=24

# --- dashboard -------------------------------------------------------------
MEMBRANE_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_MEMBRANE_API=http://localhost:8080
