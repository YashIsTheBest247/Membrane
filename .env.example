# ---------------------------------------------------------------------------
# Membrane configuration.  Copy to .env and edit.
# Full reference with explanations: docs/CONFIGURATION.md
#
# To run locally you need NOTHING here — it defaults to SQLite and an
# in-process event bus.  The two secrets below are the only values you MUST
# change before this faces anything real.
# ---------------------------------------------------------------------------

MEMBRANE_ENVIRONMENT=dev

# --- secrets — CHANGE BOTH:  openssl rand -hex 32 --------------------------
# Signs intent contracts and Telegram callbacks. Rotating it invalidates every
# outstanding contract, which is the intended emergency behaviour.
MEMBRANE_SIGNING_KEY=dev-insecure-signing-key-change-me
# Salts every span hash in the audit trail. Rotating it makes historical
# hashes unverifiable — deliberate, not casual.
MEMBRANE_HASH_SALT=dev-insecure-hash-salt-change-me

# --- storage ---------------------------------------------------------------
# Default is a local SQLite file. docker compose overrides with Postgres.
# MEMBRANE_DATABASE_URL=postgresql+asyncpg://membrane:membrane@localhost:5432/membrane
# Redis is only needed when running more than one instance.
# MEMBRANE_REDIS_URL=redis://localhost:6379/0

# --- the human loop --------------------------------------------------------
# Both must be set, or cards resolve in the dashboard instead (a supported
# mode). Token from @BotFather, chat id from @userinfobot.
# Then register the webhook — needs a public HTTPS URL:
#   curl -X POST "https://your-host/v1/telegram/register?base_url=https://your-host"
# MEMBRANE_TELEGRAM_BOT_TOKEN=123456789:AAF-abc123...
# MEMBRANE_TELEGRAM_CHAT_ID=987654321
MEMBRANE_APPROVAL_TIMEOUT_SECONDS=60
# Set false to make the bot the only way to approve.
MEMBRANE_DASHBOARD_APPROVALS_ENABLED=true

# --- L2 model escalation (optional) ----------------------------------------
# Without it, ambiguous spans quarantine: the deterministic tier is fail-closed,
# never fail-open. Configure it for multilingual content.
# MEMBRANE_GEMINI_API_KEY=AIza...
# MEMBRANE_VERTEX_PROJECT=my-gcp-project
# MEMBRANE_VERTEX_LOCATION=us-central1
# MEMBRANE_VERTEX_MODEL=gemini-2.0-flash

# --- policy tuning ---------------------------------------------------------
MEMBRANE_SEPARATOR_QUARANTINE_THRESHOLD=0.60
MEMBRANE_SEPARATOR_AMBIGUOUS_THRESHOLD=0.35
MEMBRANE_CONTRACT_TTL_SECONDS=900
MEMBRANE_MAX_DECODE_DEPTH=4
MEMBRANE_BREAKER_HOLD_THRESHOLD=5
MEMBRANE_BREAKER_WINDOW_SECONDS=120
MEMBRANE_BREAKER_COOLDOWN_SECONDS=300
MEMBRANE_TRUST_INITIAL=0.70
MEMBRANE_TRUST_INCIDENT_MULTIPLIER=0.35
MEMBRANE_TRUST_RECOVERY_PER_HOUR=0.01
# MEMBRANE_POLICY_FILE=./policy.yaml

# --- privacy — set both to false in production -----------------------------
# Previews stream inspected text to the dashboard from memory. Never persisted,
# but no reason to emit them in production.
MEMBRANE_LIVE_PREVIEW_ENABLED=true
MEMBRANE_LIVE_PREVIEW_CHARS=160
# The one setting that makes Membrane store text. Bounded, expires, off.
MEMBRANE_REPLAY_RETENTION_ENABLED=false
MEMBRANE_REPLAY_RETENTION_HOURS=24

# --- network ---------------------------------------------------------------
# Comma separated. Must list the origin the dashboard is served from whenever
# it is not the same origin as the API — a split Vercel/Render deploy, say.
MEMBRANE_CORS_ORIGINS=http://localhost:3000
# Optional, and matched in addition to the list above. Needed only where the
# platform mints a new hostname per deployment, so an exhaustive list is
# impossible — every Vercel preview is its own origin. Anchor both ends.
#   ^https://membrane-[a-z0-9-]+\.vercel\.app$
MEMBRANE_CORS_ORIGIN_REGEX=

# --- dashboard (NOT prefixed; inlined at BUILD time) -----------------------
NEXT_PUBLIC_MEMBRANE_API=http://localhost:8080

# --- rarely changed --------------------------------------------------------
# MEMBRANE_SERVICE_NAME=membrane-api
# MEMBRANE_MAX_CONTENT_BYTES=4194304        # 4 MB per ingest call
# MEMBRANE_ESCALATION_ENABLED=true          # false = deterministic tier only
# MEMBRANE_VERTEX_TIMEOUT_SECONDS=3.0       # on timeout the span quarantines
# MEMBRANE_TELEGRAM_API_BASE=https://api.telegram.org   # override for testing
